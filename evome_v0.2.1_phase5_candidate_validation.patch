@@ -0,0 +1,554 @@
+from __future__ import annotations
+
+import copy
+import json
+from dataclasses import dataclass
+from typing import Any
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.context.schema import sanitize_applicable_context
+from app.models import (
+    CandidateRevision,
+    Experience,
+    HypothesisEvidence,
+    HypothesisRevision,
+    ReflectionRecord,
+    RevisionProposal,
+    RevisionSignal,
+)
+
+
+RELATION_WEIGHTS = {
+    "SUPPORTS": 1.0,
+    "REFINES": -0.35,
+    "CONFLICTS": -1.0,
+    "UNRELATED": -0.50,
+}
+
+OPERATION_RISK = {
+    "NARROW": 0.05,
+    "SPECIALIZE": 0.08,
+    "ADD_CONDITION": 0.08,
+    "CHANGE": 0.20,
+    "EXPAND": 0.18,
+    "REMOVE_CONDITION": 0.25,
+    "GENERALIZE": 0.30,
+}
+
+DIMENSION_RISK = {
+    "CONTEXT": 0.10,
+    "ACTION": 0.15,
+    "OUTCOME": 0.03,
+    "ABSTRACTION": 0.25,
+}
+
+DIMENSION_TARGET = {
+    "CONTEXT": "when_data",
+    "ACTION": "do_data",
+    "OUTCOME": "expect_data",
+}
+
+DIMENSION_ALIAS = {
+    "CONTEXT": "when",
+    "ACTION": "do",
+    "OUTCOME": "expect",
+}
+
+
+@dataclass(frozen=True)
+class CandidateEvaluationResult:
+    candidate: CandidateRevision
+    llm_called: bool
+
+
+class CandidateRevisionService:
+    """Phase 5: build and evaluate candidate hypothesis revisions.
+
+    A CandidateRevision is an experiment, not an active HypothesisRevision.
+    The service never changes StrategyHypothesis.current_revision and never
+    creates a new HypothesisRevision. One proposal maps to at most one
+    candidate, making evaluation idempotent.
+    """
+
+    def __init__(
+        self,
+        db: Session,
+        llm,
+        *,
+        max_evidence: int = 8,
+    ) -> None:
+        self.db = db
+        self.llm = llm
+        self.max_evidence = max(1, int(max_evidence))
+
+    @staticmethod
+    def _clamp(value: Any, default: float = 0.0) -> float:
+        try:
+            parsed = float(value)
+        except (TypeError, ValueError):
+            parsed = default
+        return max(0.0, min(1.0, parsed))
+
+    @staticmethod
+    def _compact_text(value: Any, limit: int = 420) -> str:
+        text = str(value or "").strip()
+        return text if len(text) <= limit else text[: limit - 1] + "…"
+
+    @staticmethod
+    def _canonical_signal(
+        when_data: dict[str, Any],
+        do_data: dict[str, Any],
+        expect_data: dict[str, Any],
+    ) -> str:
+        return json.dumps(
+            {
+                "when": when_data,
+                "do": do_data,
+                "expect": expect_data,
+            },
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+
+    @classmethod
+    def _complexity_of(cls, value: Any, *, depth: int = 0) -> int:
+        if value is None:
+            return 0
+        if isinstance(value, dict):
+            if not value:
+                return 0
+            child_score = sum(cls._complexity_of(item, depth=depth + 1) for item in value.values())
+            return len(value) + child_score + (1 if depth >= 2 else 0)
+        if isinstance(value, (list, tuple, set)):
+            if not value:
+                return 0
+            return len(value) + sum(cls._complexity_of(item, depth=depth + 1) for item in value)
+        if isinstance(value, str):
+            if not value.strip():
+                return 0
+            return 1 + min(2, len(value) // 180)
+        return 1
+
+    @classmethod
+    def _revision_complexity(
+        cls,
+        when_data: dict[str, Any],
+        do_data: dict[str, Any],
+        expect_data: dict[str, Any],
+    ) -> int:
+        return (
+            cls._complexity_of(when_data)
+            + cls._complexity_of(do_data)
+            + cls._complexity_of(expect_data)
+        )
+
+    @staticmethod
+    def _extract_patch_value(proposal: RevisionProposal) -> tuple[str, Any]:
+        dimension = str(proposal.dimension).upper()
+        alias = DIMENSION_ALIAS.get(dimension)
+        data = proposal.proposed_after_data
+
+        if isinstance(data, dict):
+            if alias and alias in data and isinstance(data[alias], dict):
+                return "merge", copy.deepcopy(data[alias])
+            if proposal.target_field in data:
+                return "field", copy.deepcopy(data[proposal.target_field])
+            # Phase 4 commonly returns metadata plus a field carrying the delta.
+            non_meta = {
+                key: value
+                for key, value in data.items()
+                if key not in {"target_field", "operation", "dimension"}
+            }
+            if len(non_meta) == 1:
+                key, value = next(iter(non_meta.items()))
+                if key == proposal.target_field:
+                    return "field", copy.deepcopy(value)
+
+        return "field", copy.deepcopy(data)
+
+    def _build_candidate_data(
+        self,
+        base: HypothesisRevision,
+        proposal: RevisionProposal,
+    ) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
+        when_data = copy.deepcopy(base.when_data or {})
+        do_data = copy.deepcopy(base.do_data or {})
+        expect_data = copy.deepcopy(base.expect_data or {})
+
+        dimension = str(proposal.dimension).upper()
+        if dimension == "ABSTRACTION":
+            data = proposal.proposed_after_data
+            if not isinstance(data, dict):
+                raise ValueError("ABSTRACTION Proposal 必须提供结构化 when/do/expect patch")
+            if isinstance(data.get("when"), dict):
+                when_data.update(copy.deepcopy(data["when"]))
+            if isinstance(data.get("do"), dict):
+                do_data.update(copy.deepcopy(data["do"]))
+            if isinstance(data.get("expect"), dict):
+                expect_data.update(copy.deepcopy(data["expect"]))
+            if not any(key in data for key in ("when", "do", "expect")):
+                raise ValueError("ABSTRACTION Proposal 缺少 when/do/expect patch")
+            return when_data, do_data, expect_data
+
+        target_name = DIMENSION_TARGET.get(dimension)
+        if target_name is None:
+            raise ValueError(f"不支持的 Revision dimension: {dimension}")
+
+        target = {
+            "when_data": when_data,
+            "do_data": do_data,
+            "expect_data": expect_data,
+        }[target_name]
+        patch_mode, patch_value = self._extract_patch_value(proposal)
+        if patch_mode == "merge" and isinstance(patch_value, dict):
+            target.update(patch_value)
+        else:
+            target[proposal.target_field] = patch_value
+
+        return when_data, do_data, expect_data
+
+    def _source_evidence_ids(self, proposal: RevisionProposal) -> set[int]:
+        ids = [int(item) for item in (proposal.source_signal_ids or []) if item is not None]
+        if not ids:
+            return set()
+        signals = self.db.scalars(
+            select(RevisionSignal).where(RevisionSignal.id.in_(ids))
+        ).all()
+        return {
+            int(signal.evidence_id)
+            for signal in signals
+            if signal.evidence_id is not None
+        }
+
+    def _evidence_rows(
+        self,
+        proposal: RevisionProposal,
+    ) -> list[tuple[HypothesisEvidence, ReflectionRecord, Experience | None]]:
+        stmt = (
+            select(HypothesisEvidence, ReflectionRecord, Experience)
+            .join(ReflectionRecord, ReflectionRecord.id == HypothesisEvidence.reflection_id)
+            .outerjoin(Experience, Experience.id == ReflectionRecord.experience_id)
+            .where(
+                HypothesisEvidence.hypothesis_id == proposal.hypothesis_id,
+                HypothesisEvidence.hypothesis_revision == proposal.base_revision,
+            )
+        )
+        rows = list(self.db.execute(stmt).all())
+        source_ids = self._source_evidence_ids(proposal)
+        relation_priority = {
+            "CONFLICTS": 0,
+            "REFINES": 1,
+            "SUPPORTS": 2,
+            "UNRELATED": 3,
+        }
+        rows.sort(
+            key=lambda row: (
+                0 if int(row[0].id) in source_ids else 1,
+                relation_priority.get(str(row[0].relation_type).upper(), 9),
+                int(row[0].id),
+            )
+        )
+        return rows[: self.max_evidence]
+
+    def _compact_evidence(
+        self,
+        rows: list[tuple[HypothesisEvidence, ReflectionRecord, Experience | None]],
+    ) -> list[dict[str, Any]]:
+        items: list[dict[str, Any]] = []
+        for evidence, reflection, experience in rows:
+            context = sanitize_applicable_context(reflection.applicable_context or {})
+            if not context and experience is not None:
+                context = sanitize_applicable_context(experience.context_data or {})
+            items.append(
+                {
+                    "evidence_id": int(evidence.id),
+                    "reflection_id": int(reflection.id),
+                    "relation_to_base": str(evidence.relation_type).upper(),
+                    "base_relation_confidence": float(evidence.relation_confidence),
+                    "context": context,
+                    "signal": self._compact_text(
+                        reflection.canonical_signal
+                        or reflection.strategy_signal
+                        or reflection.insight
+                        or reflection.lesson
+                    ),
+                    "expected_effect": self._compact_text(reflection.expected_effect),
+                }
+            )
+        return items
+
+    def _reevaluate(
+        self,
+        candidate: dict[str, Any],
+        evidence: list[dict[str, Any]],
+    ) -> dict[str, Any]:
+        messages = [
+            {
+                "role": "system",
+                "content": (
+                    "Evaluate a candidate Strategy Hypothesis against compact historical evidence. "
+                    "Judge each evidence independently against the candidate, not against the old hypothesis. "
+                    "Allowed relations: SUPPORTS, REFINES, CONFLICTS, UNRELATED. "
+                    "Do not invent evidence or broaden context. Return JSON with one key `relations`, "
+                    "a list of objects: evidence_id, relation, confidence (0..1), reason."
+                ),
+            },
+            {
+                "role": "user",
+                "content": json.dumps(
+                    {"candidate": candidate, "evidence": evidence},
+                    ensure_ascii=False,
+                    sort_keys=True,
+                ),
+            },
+        ]
+        result = self.llm.json_chat(messages, temperature=0.1)
+        return result if isinstance(result, dict) else {}
+
+    @staticmethod
+    def _normalize_relations(
+        raw: dict[str, Any],
+        evidence_ids: set[int],
+    ) -> list[dict[str, Any]]:
+        result: list[dict[str, Any]] = []
+        seen: set[int] = set()
+        rows = raw.get("relations", [])
+        if not isinstance(rows, list):
+            return result
+        for item in rows:
+            if not isinstance(item, dict):
+                continue
+            try:
+                evidence_id = int(item.get("evidence_id"))
+            except (TypeError, ValueError):
+                continue
+            if evidence_id not in evidence_ids or evidence_id in seen:
+                continue
+            relation = str(item.get("relation", "")).upper().strip()
+            if relation not in RELATION_WEIGHTS:
+                continue
+            seen.add(evidence_id)
+            try:
+                confidence = float(item.get("confidence", 0.0))
+            except (TypeError, ValueError):
+                confidence = 0.0
+            result.append(
+                {
+                    "evidence_id": evidence_id,
+                    "relation": relation,
+                    "confidence": max(0.0, min(1.0, confidence)),
+                    "reason": str(item.get("reason", "")).strip(),
+                }
+            )
+        return result
+
+    @staticmethod
+    def _fit_score(relations: list[dict[str, Any]]) -> float:
+        if not relations:
+            return 0.0
+        total_weight = 0.0
+        weighted = 0.0
+        for item in relations:
+            confidence = max(0.05, float(item.get("confidence", 0.0)))
+            weighted += RELATION_WEIGHTS.get(str(item.get("relation", "")).upper(), -0.5) * confidence
+            total_weight += confidence
+        raw = weighted / total_weight if total_weight else -1.0
+        return round(max(0.0, min(1.0, (raw + 1.0) / 2.0)), 4)
+
+    @classmethod
+    def _base_relations(
+        cls,
+        rows: list[tuple[HypothesisEvidence, ReflectionRecord, Experience | None]],
+    ) -> list[dict[str, Any]]:
+        return [
+            {
+                "evidence_id": int(evidence.id),
+                "relation": str(evidence.relation_type).upper(),
+                "confidence": float(evidence.relation_confidence),
+            }
+            for evidence, _reflection, _experience in rows
+        ]
+
+    @staticmethod
+    def _relation_counts(relations: list[dict[str, Any]]) -> dict[str, int]:
+        counts = {"SUPPORTS": 0, "REFINES": 0, "CONFLICTS": 0, "UNRELATED": 0}
+        for item in relations:
+            relation = str(item.get("relation", "")).upper()
+            if relation in counts:
+                counts[relation] += 1
+        return counts
+
+    @staticmethod
+    def _risk(
+        proposal: RevisionProposal,
+        complexity_delta: int,
+    ) -> tuple[float, str]:
+        score = OPERATION_RISK.get(str(proposal.operation).upper(), 0.25)
+        score += DIMENSION_RISK.get(str(proposal.dimension).upper(), 0.20)
+        if complexity_delta > 3:
+            score += 0.08
+        if complexity_delta > 8:
+            score += 0.10
+        score = max(0.0, min(1.0, score))
+        if score <= 0.30:
+            return round(score, 4), "LOW"
+        if score <= 0.60:
+            return round(score, 4), "MEDIUM"
+        return round(score, 4), "HIGH"
+
+    @staticmethod
+    def _status(
+        *,
+        fit_gain: float,
+        utility: float,
+        risk_level: str,
+        coverage: float,
+        base_counts: dict[str, int],
+        candidate_counts: dict[str, int],
+    ) -> str:
+        if coverage < 0.80:
+            return "needs_review"
+        if candidate_counts.get("CONFLICTS", 0) > base_counts.get("CONFLICTS", 0):
+            return "rejected"
+        if fit_gain <= 0.02:
+            return "rejected"
+        if risk_level == "LOW" and utility >= 0.08:
+            return "ready_to_apply"
+        return "needs_review"
+
+    def evaluate_proposal(self, proposal: RevisionProposal) -> CandidateEvaluationResult:
+        existing = self.db.scalar(
+            select(CandidateRevision).where(
+                CandidateRevision.source_proposal_id == proposal.id
+            )
+        )
+        if existing is not None:
+            return CandidateEvaluationResult(existing, llm_called=False)
+
+        base = self.db.scalar(
+            select(HypothesisRevision).where(
+                HypothesisRevision.hypothesis_id == proposal.hypothesis_id,
+                HypothesisRevision.revision_number == proposal.base_revision,
+            )
+        )
+        if base is None:
+            raise ValueError(
+                f"H#{proposal.hypothesis_id}:r{proposal.base_revision} 不存在"
+            )
+
+        when_data, do_data, expect_data = self._build_candidate_data(base, proposal)
+        base_complexity = self._revision_complexity(
+            base.when_data or {}, base.do_data or {}, base.expect_data or {}
+        )
+        candidate_complexity = self._revision_complexity(
+            when_data, do_data, expect_data
+        )
+        complexity_delta = candidate_complexity - base_complexity
+
+        rows = self._evidence_rows(proposal)
+        compact = self._compact_evidence(rows)
+        evidence_ids = {int(item["evidence_id"]) for item in compact}
+        raw = self._reevaluate(
+            {
+                "hypothesis_id": proposal.hypothesis_id,
+                "base_revision": proposal.base_revision,
+                "source_proposal_id": proposal.id,
+                "when": when_data,
+                "do": do_data,
+                "expect": expect_data,
+            },
+            compact,
+        )
+        candidate_relations = self._normalize_relations(raw, evidence_ids)
+        coverage = round(
+            len(candidate_relations) / len(compact), 4
+        ) if compact else 0.0
+
+        base_relations = self._base_relations(rows)
+        base_fit = self._fit_score(base_relations)
+        candidate_fit = self._fit_score(candidate_relations)
+        fit_gain = round(candidate_fit - base_fit, 4)
+
+        complexity_penalty = round(
+            min(0.15, max(0, complexity_delta) * 0.01), 4
+        )
+        risk_score, risk_level = self._risk(proposal, complexity_delta)
+        risk_penalty = round(risk_score * 0.20, 4)
+        utility = round(fit_gain - complexity_penalty - risk_penalty, 4)
+
+        base_counts = self._relation_counts(base_relations)
+        candidate_counts = self._relation_counts(candidate_relations)
+        status = self._status(
+            fit_gain=fit_gain,
+            utility=utility,
+            risk_level=risk_level,
+            coverage=coverage,
+            base_counts=base_counts,
+            candidate_counts=candidate_counts,
+        )
+
+        candidate = CandidateRevision(
+            hypothesis_id=proposal.hypothesis_id,
+            base_revision=proposal.base_revision,
+            source_proposal_id=proposal.id,
+            title=base.title,
+            insight=base.insight,
+            when_data=when_data,
+            do_data=do_data,
+            expect_data=expect_data,
+            canonical_signal=self._canonical_signal(when_data, do_data, expect_data),
+            status=status,
+            base_fit_score=base_fit,
+            candidate_fit_score=candidate_fit,
+            fit_gain=fit_gain,
+            base_complexity_score=base_complexity,
+            complexity_score=candidate_complexity,
+            complexity_delta=complexity_delta,
+            risk_level=risk_level,
+            risk_score=risk_score,
+            utility_score=utility,
+            evidence_ids=sorted(evidence_ids),
+            evaluation_data={
+                "coverage": coverage,
+                "base_relations": base_relations,
+                "candidate_relations": candidate_relations,
+                "base_counts": base_counts,
+                "candidate_counts": candidate_counts,
+                "complexity_penalty": complexity_penalty,
+                "risk_penalty": risk_penalty,
+            },
+        )
+        self.db.add(candidate)
+        self.db.commit()
+        self.db.refresh(candidate)
+        return CandidateEvaluationResult(candidate, llm_called=True)
+
+    def evaluate_pending(self, *, max_candidates: int = 2) -> list[CandidateEvaluationResult]:
+        limit = max(0, int(max_candidates))
+        if limit == 0:
+            return []
+        stmt = (
+            select(RevisionProposal)
+            .where(RevisionProposal.status == "proposed")
+            .order_by(RevisionProposal.id.asc())
+        )
+        results: list[CandidateEvaluationResult] = []
+        for proposal in self.db.scalars(stmt).all():
+            exists = self.db.scalar(
+                select(CandidateRevision.id).where(
+                    CandidateRevision.source_proposal_id == proposal.id
+                )
+            )
+            if exists is not None:
+                continue
+            results.append(self.evaluate_proposal(proposal))
+            if len(results) >= limit:
+                break
+        return results
+
+    def list_candidates(self) -> list[CandidateRevision]:
+        stmt = select(CandidateRevision).order_by(CandidateRevision.id.desc())
+        return list(self.db.scalars(stmt).all())
