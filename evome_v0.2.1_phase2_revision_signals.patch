diff --git a/app/hypothesis/revision_signal.py b/app/hypothesis/revision_signal.py
new file mode 100644
index 0000000..f373174
--- /dev/null
+++ b/app/hypothesis/revision_signal.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from typing import Any
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.models import HypothesisEvidence, ReflectionRecord, RevisionSignal, StrategyHypothesis
+
+
+class RevisionSignalService:
+    """保存 Relation Judge 在 REFINES 时产生的局部 Revision Signal。
+
+    Phase 2 只负责记录与查询，不做聚合、不生成 Proposal、不修改 Hypothesis。
+    """
+
+    def __init__(self, db: Session) -> None:
+        self.db = db
+
+    def list_all(
+        self,
+        *,
+        hypothesis_id: int | None = None,
+        base_revision: int | None = None,
+    ) -> list[RevisionSignal]:
+        stmt = select(RevisionSignal)
+        if hypothesis_id is not None:
+            stmt = stmt.where(RevisionSignal.hypothesis_id == hypothesis_id)
+        if base_revision is not None:
+            stmt = stmt.where(RevisionSignal.base_revision == base_revision)
+        stmt = stmt.order_by(RevisionSignal.created_at.asc(), RevisionSignal.id.asc())
+        return list(self.db.scalars(stmt).all())
+
+    def create_from_refines(
+        self,
+        *,
+        hypothesis: StrategyHypothesis,
+        reflection: ReflectionRecord,
+        evidence: HypothesisEvidence,
+        raw_signals: list[dict[str, Any]],
+    ) -> list[RevisionSignal]:
+        if evidence.relation_type != "REFINES":
+            return []
+
+        target_revision = int(evidence.hypothesis_revision)
+        created: list[RevisionSignal] = []
+
+        for raw in raw_signals:
+            dimension = str(raw.get("dimension", "")).strip().upper()
+            operation = str(raw.get("operation", "")).strip().upper()
+            target_field = str(raw.get("target_field", "")).strip()
+            canonical_change = str(raw.get("canonical_change", "")).strip()
+            if not dimension or not operation or not target_field or not canonical_change:
+                continue
+
+            existing = self.db.scalar(
+                select(RevisionSignal).where(
+                    RevisionSignal.hypothesis_id == hypothesis.id,
+                    RevisionSignal.base_revision == target_revision,
+                    RevisionSignal.reflection_id == reflection.id,
+                    RevisionSignal.dimension == dimension,
+                    RevisionSignal.operation == operation,
+                    RevisionSignal.target_field == target_field,
+                )
+            )
+            if existing is not None:
+                continue
+
+            try:
+                confidence = float(raw.get("confidence", evidence.relation_confidence))
+            except (TypeError, ValueError):
+                confidence = float(evidence.relation_confidence)
+            confidence = max(0.0, min(1.0, confidence))
+
+            interaction_id = None
+            if reflection.experience_id is not None:
+                # 通过 Reflection -> Experience 获取 interaction id；避免 Signal 再读原始交互内容。
+                from app.models import Experience
+
+                experience = self.db.get(Experience, reflection.experience_id)
+                if experience is not None:
+                    interaction_id = experience.interaction_id
+
+            signal = RevisionSignal(
+                hypothesis_id=hypothesis.id,
+                base_revision=target_revision,
+                reflection_id=reflection.id,
+                evidence_id=evidence.id,
+                interaction_id=interaction_id,
+                dimension=dimension,
+                operation=operation,
+                target_field=target_field,
+                before_data=raw.get("before_data", {}),
+                observed_data=raw.get("observed_data", {}),
+                canonical_change=canonical_change,
+                confidence=confidence,
+            )
+            self.db.add(signal)
+            created.append(signal)
+
+        if created:
+            self.db.commit()
+            for signal in created:
+                self.db.refresh(signal)
+        return created
