+                ),
+                "decision_source": "deterministic_hard_pass",
+            }
+
+        # Save tokens on only the clearest low-value cases. Everything else
+        # remains ambiguous and is sent to the LLM gate.
+        if self._is_obvious_low_value(user_input):
