diff --git a/tests/test_cli_commands.py b/tests/test_cli_commands.py
new file mode 100644
index 0000000..91a92bd
--- /dev/null
+++ b/tests/test_cli_commands.py
@@ -0,0 +1,15 @@
+from app.cli_commands import normalize_cli_input
+
+
+def test_known_command_without_slash_is_normalized():
+    assert normalize_cli_input("revision-signals") == "/revision-signals"
+    assert normalize_cli_input("candidate-approve 3") == "/candidate-approve 3"
+
+
+def test_natural_language_is_not_rewritten():
+    assert normalize_cli_input("hypothesis 是什么意思？") == "hypothesis 是什么意思？"
+    assert normalize_cli_input("帮我分析 revision signal") == "帮我分析 revision signal"
+
+
+def test_existing_slash_command_is_unchanged():
+    assert normalize_cli_input("/status") == "/status"
diff --git a/tests/test_learning_eligibility_gate.py b/tests/test_learning_eligibility_gate.py
new file mode 100644
index 0000000..30b9ca2
--- /dev/null
+++ b/tests/test_learning_eligibility_gate.py
@@ -0,0 +1,159 @@
+from app.gates.learning_eligibility_gate import LearningEligibilityGate
+
+
+class CountingLLM:
+    def __init__(self, result=None):
+        self.calls = 0
+        self.result = result if result is not None else {
+            "category": "natural",
+            "allow_personal_memory": False,
+            "allow_evolution": False,
+            "reason": "no durable learning signal",
+        }
+
+    def json_chat(self, messages, temperature=0.1):
+        self.calls += 1
+        return self.result
+
+
+def test_operational_input_is_audit_only_without_llm():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("revision-signals")
+
+    assert result["category"] == "operational"
+    assert result["learning_eligible"] is False
+    assert result["allow_personal_memory"] is False
+    assert result["allow_evolution"] is False
+    assert llm.calls == 0
+
+
+def test_noise_is_audit_only_without_llm():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("......")
+
+    assert result["category"] == "noise"
+    assert result["learning_eligible"] is False
+    assert llm.calls == 0
+
+
+def test_testing_input_does_not_write_simulated_user_fact():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("假设我喜欢 Java，这只是测试，不是真的。")
+
+    assert result["category"] == "testing"
+    assert result["allow_personal_memory"] is False
+    assert result["allow_evolution"] is False
+    assert llm.calls == 0
+
+
+def test_testing_can_opt_into_evolution_but_never_personal_memory():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("这只是测试，把这次测试结果作为经验记录下来。")
+
+    assert result["category"] == "testing"
+    assert result["allow_personal_memory"] is False
+    assert result["allow_evolution"] is True
+    assert llm.calls == 0
+
+
+def test_pure_user_fact_uses_memory_lane_only():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("我正在开发 EvoMe。")
+
+    assert result["category"] == "natural"
+    assert result["allow_personal_memory"] is True
+    assert result["allow_evolution"] is False
+    assert llm.calls == 0
+
+
+def test_meta_observation_is_audit_only():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("你现在有哪些 hypothesis？")
+
+    assert result["category"] == "meta"
+    assert result["allow_personal_memory"] is False
+    assert result["allow_evolution"] is False
+    assert llm.calls == 0
+
+
+def test_real_structural_task_can_enter_evolution():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("请检查 EvoMe 的模块职责、数据流和边界，然后给出修复方案。")
+
+    assert result["category"] == "natural"
+    assert result["allow_evolution"] is True
+    assert llm.calls == 0
+
+
+def test_ordinary_knowledge_question_is_audit_only():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("Python 的 list 是什么？")
+
+    assert result["category"] == "natural"
+    assert result["learning_eligible"] is False
+    assert llm.calls == 0
+
+
+def test_explicit_feedback_enters_evolution():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("你刚才讲错了，应该先解释数据流再讲接口。")
+
+    assert result["category"] == "natural"
+    assert result["allow_evolution"] is True
+    assert llm.calls == 0
+
+
+def test_ambiguous_input_uses_llm():
+    llm = CountingLLM({
+        "category": "natural",
+        "allow_personal_memory": False,
+        "allow_evolution": True,
+        "reason": "real task execution",
+    })
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("帮我看看这个方案是否合理。")
+
+    assert result["allow_evolution"] is True
+    assert result["decision_source"] == "llm"
+    assert llm.calls == 1
+
+
+def test_invalid_llm_output_fails_closed():
+    llm = CountingLLM({})
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("这是一段无法由确定性规则判断的内容")
+
+    assert result["learning_eligible"] is False
+    assert result["decision_source"] == "llm_fail_closed"
+    assert llm.calls == 1
+
+
+def test_real_debugging_question_is_not_mistaken_for_ordinary_qa():
+    llm = CountingLLM()
+    gate = LearningEligibilityGate(llm)
+
+    result = gate.classify("为什么我的 FastAPI 接口一直报错 502？")
+
+    assert result["category"] == "natural"
+    assert result["allow_evolution"] is True
+    assert llm.calls == 0
diff --git a/tests/test_learning_eligibility_integration.py b/tests/test_learning_eligibility_integration.py
new file mode 100644
index 0000000..8c777e3
--- /dev/null
+++ b/tests/test_learning_eligibility_integration.py
@@ -0,0 +1,85 @@
+from app.runtime import EvoMeRuntime
+from tests.test_workflow import FakeLLM
+
+
+class EligibilityAwareFakeLLM(FakeLLM):
+    def json_chat(self, messages, temperature=0.1):
+        system = messages[0]["content"]
+        if "MODULE: LEARNING_ELIGIBILITY_GATE" in system:
+            # Tests below intentionally use deterministic eligibility paths.
+            raise AssertionError("deterministic eligibility rule should have handled this input")
+        return super().json_chat(messages, temperature=temperature)
+
+
+def test_simulated_preference_is_audit_only(db):
+    runtime = EvoMeRuntime(
+        db,
+        llm=EligibilityAwareFakeLLM(),
+        session_id="eligibility-test",
+        enable_background=False,
+    )
+
+    result = runtime.run("假设我喜欢 Java，这只是测试，不是真的。")
+
+    assert result["learning_category"] == "testing"
+    assert result["allow_personal_memory"] is False
+    assert result["allow_evolution"] is False
+    assert len(runtime.list_interactions()) == 1
+    assert len(runtime.list_personal_memories()) == 0
+    assert len(runtime.list_experiences()) == 0
+    assert len(runtime.list_reflections()) == 0
+
+    metadata = runtime.list_interactions()[0].record_metadata
+    assert metadata["learning_eligibility"]["category"] == "testing"
+    assert "evaluation" not in metadata
+
+
+def test_user_fact_can_write_memory_without_creating_experience(db):
+    runtime = EvoMeRuntime(
+        db,
+        llm=EligibilityAwareFakeLLM(),
+        session_id="memory-only-test",
+        enable_background=False,
+    )
+
+    result = runtime.run("我正在开发 EvoMe。")
+
+    assert result["allow_personal_memory"] is True
+    assert result["allow_evolution"] is False
+    assert result["personal_memories_saved"] == 1
+    assert len(runtime.list_personal_memories()) == 1
+    assert len(runtime.list_experiences()) == 0
+
+
+def test_meta_observation_does_not_create_evolution_data(db):
+    runtime = EvoMeRuntime(
+        db,
+        llm=EligibilityAwareFakeLLM(),
+        session_id="meta-test",
+        enable_background=False,
+    )
+
+    result = runtime.run("你现在有哪些 hypothesis？")
+
+    assert result["learning_category"] == "meta"
+    assert result["learning_eligible"] is False
+    assert len(runtime.list_interactions()) == 1
+    assert len(runtime.list_experiences()) == 0
+    assert len(runtime.list_hypotheses()) == 0
+
+
+def test_real_architecture_task_still_enters_evolution(db):
+    runtime = EvoMeRuntime(
+        db,
+        llm=EligibilityAwareFakeLLM(),
+        session_id="real-task-test",
+        enable_background=False,
+    )
+
+    result = runtime.run(
+        "请和我一起检查 PersonalMemory 和 Experience 两个模块的数据边界、职责边界和数据流。"
+    )
+
+    assert result["allow_evolution"] is True
+    assert result["experience_saved"] is True
+    assert result["reflection_saved"] is True
