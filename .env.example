# Required
DEEPSEEK_API_KEY=

# Model endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Persistence
EVOME_DB_URL=sqlite:///./evome.db
EVOME_QDRANT_PATH=./evome_qdrant

# LLM output limits by workload
EVOME_MAX_TOKENS_CHAT=4096
# Agent decisions also carry the complete user-facing answer.
EVOME_MAX_TOKENS_AGENT=4096
EVOME_MAX_TOKENS_JSON_DEFAULT=768
EVOME_MAX_TOKENS_EVALUATION=512
EVOME_MAX_TOKENS_GATE=384
EVOME_MAX_TOKENS_CONTEXT=768
EVOME_MAX_TOKENS_REFLECTION=1024
EVOME_MAX_TOKENS_POST_TURN=1200
EVOME_MAX_TOKENS_RELATION=1024
EVOME_MAX_TOKENS_REVISION=1200

# Phase 5.7C: evolution cadence. Audit and Personal Memory still run every turn.
EVOME_SLOW_LOOP_EVERY_N_TURNS=1

# Phase 5.7C: max chars of an assistant response in internal JSON-helper prompts.
EVOME_PROMPT_RESPONSE_CHAR_LIMIT=800

# Phase 5.7D: max chars per recalled memory in internal prompts.
EVOME_PROMPT_MEMORY_CHAR_LIMIT=200

# Hypothesis retrieval
HYPOTHESIS_TOP_K=5
HYPOTHESIS_SCORE_THRESHOLD=0.60
HYPOTHESIS_RELATION_CONFIDENCE=0.60

# Revision analysis and candidate validation
REVISION_ANALYSIS_MIN_INDEPENDENT_SIGNALS=2
REVISION_ANALYSIS_MAX_PER_RUN=2
REVISION_CANDIDATE_MAX_PER_RUN=2
REVISION_CANDIDATE_MAX_EVIDENCE=8

# Controlled auto-apply
REVISION_AUTO_APPLY_MIN_UTILITY=0.20
REVISION_AUTO_APPLY_BUDGET_HOURS=24
REVISION_AUTO_APPLY_PER_HYPOTHESIS=1
REVISION_AUTO_APPLY_MAX_PER_RUN=2

# Ancestor signal revalidation
REVISION_REVALIDATION_MAX_SIGNALS_PER_BATCH=16
REVISION_REVALIDATION_MAX_HYPOTHESES_PER_RUN=2

# S1 Agent Loop
EVOME_AGENT_LOOP_ENABLED=0
EVOME_AGENT_MAX_STEPS=6

# S2 Tool Use
EVOME_TOOL_WORKSPACE=.
EVOME_BASH_TOOL_ENABLED=0
EVOME_BASH_TIMEOUT_SECONDS=20
EVOME_TOOL_MAX_OUTPUT_CHARS=12000

# S3 Permission: allow | ask | deny
EVOME_BASH_PERMISSION=ask

# S04 Hooks (before/after Agent and Tool events)
EVOME_HOOKS_ENABLED=1
EVOME_HOOK_HISTORY_LIMIT=100
EVOME_HOOK_PROTECT_SECRETS=1

# S05 Planning: opt-in (Agent Loop must also be enabled)
EVOME_PLANNING_ENABLED=0
EVOME_PLAN_MAX_TASKS=5
EVOME_PLAN_STEP_MAX_STEPS=4
# Up to two additional batches for read-only steps, then pause with a checkpoint.
EVOME_PLAN_STEP_MAX_CONTINUATIONS=2
EVOME_PLAN_MAX_REPLANS=1
EVOME_PLAN_AUTO_REPLAN=0
# Require read_file/glob evidence for file-inspection plan steps.
EVOME_PLAN_REQUIRE_FILE_EVIDENCE=1
