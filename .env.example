# Required
DEEPSEEK_API_KEY=

# Model endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Persistence
EVOME_DB_URL=sqlite:///./evome.db
EVOME_QDRANT_PATH=./evome_qdrant

# LLM output limits by workload
EVOME_MAX_TOKENS_CHAT=4096
EVOME_MAX_TOKENS_JSON_DEFAULT=768
EVOME_MAX_TOKENS_EVALUATION=512
EVOME_MAX_TOKENS_GATE=384
EVOME_MAX_TOKENS_CONTEXT=768
EVOME_MAX_TOKENS_REFLECTION=1024
EVOME_MAX_TOKENS_RELATION=1024
EVOME_MAX_TOKENS_REVISION=1200

# Hypothesis retrieval
HYPOTHESIS_TOP_K=5
HYPOTHESIS_SCORE_THRESHOLD=0.60
HYPOTHESIS_RELATION_CONFIDENCE=0.60

# Revision analysis and candidate validation
REVISION_ANALYSIS_MIN_INDEPENDENT_SIGNALS=2
REVISION_ANALYSIS_MAX_PER_RUN=2
REVISION_CANDIDATE_MAX_PER_RUN=2
REVISION_CANDIDATE_MAX_EVIDENCE=8

# Controlled auto-apply
REVISION_AUTO_APPLY_MIN_UTILITY=0.20
REVISION_AUTO_APPLY_BUDGET_HOURS=24
REVISION_AUTO_APPLY_PER_HYPOTHESIS=1
REVISION_AUTO_APPLY_MAX_PER_RUN=2

# Ancestor signal revalidation
REVISION_REVALIDATION_MAX_SIGNALS_PER_BATCH=16
REVISION_REVALIDATION_MAX_HYPOTHESES_PER_RUN=2
